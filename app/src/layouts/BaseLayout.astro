---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Frank Osasere Idugboe | Cloud & DevOps Engineer',
  description = 'Frank Osasere Idugboe — Cloud & DevOps Engineer, AWS Community Builder, and Digital Forensics Researcher.',
  image = '/images/frank-idugboe.png',
} = Astro.props;

const siteURL = 'https://frankidugboe.com';
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? siteURL,
).toString();

const ogImageURL = new URL(image, Astro.site ?? siteURL).toString();

const personSchema = {
  "@type": "Person",
  "@id": `${siteURL}/#person`,
  "name": "Frank Osasere Idugboe",
  "url": siteURL,
  "description":
    "Cloud & DevOps Engineer, AWS Community Builder, and Digital Forensics Researcher.",
  "jobTitle": [
    "Cloud & DevOps Engineer",
    "Digital Forensics Researcher",
  ],
  "affiliation": {
    "@type": "CollegeOrUniversity",
    "name": "UNIFESSPA",
  },
  "sameAs": [
    "https://github.com/kloudmaster",
    "https://www.linkedin.com/in/kloudmaster/",
  ],
  "knowsAbout": [
    "AWS",
    "DevOps",
    "Kubernetes",
    "Infrastructure as Code",
    "Cloud Security",
    "Cloud Forensics",
    "IoT Forensics",
    "Digital Forensics",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteURL}/#website`,
  "url": siteURL,
  "name": "Frank Osasere Idugboe",
  "description":
    "Professional portfolio of Frank Osasere Idugboe covering Cloud, DevOps, AWS, Cloud Security, and Digital Forensics.",
  "publisher": {
    "@id": `${siteURL}/#person`,
  },
};

const profilePageSchema = {
  "@type": "ProfilePage",
  "@id": `${siteURL}/#profilepage`,
  "url": siteURL,
  "name": "Frank Osasere Idugboe",
  "description":
    "Professional profile of Frank Osasere Idugboe — Cloud & DevOps Engineer, AWS Community Builder, and Digital Forensics Researcher.",
  "isPartOf": {
    "@id": `${siteURL}/#website`,
  },
  "mainEntity": {
    "@id": `${siteURL}/#person`,
  },
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": {
    "@id": `${siteURL}/#website`,
  },
  "about": {
    "@id": `${siteURL}/#person`,
  },
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph":
    Astro.url.pathname === '/'
      ? [personSchema, websiteSchema, profilePageSchema]
      : [personSchema, websiteSchema, webPageSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Mark that JavaScript is available before first paint. The reveal
         animations only hide content when this class is present, so content
         stays visible if JavaScript is disabled or fails to load. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020617" />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frank Osasere Idugboe" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Frank Osasere Idugboe — Cloud & DevOps Engineer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>

  <body class="bg-white text-slate-950 antialiased">
    <slot />

    <script>
      // Reveal elements marked with .reveal as they scroll into view.
      // Dependency-free; honours prefers-reduced-motion via the CSS above.
      const revealTargets = document.querySelectorAll('.reveal');

      if (
        'IntersectionObserver' in window &&
        revealTargets.length > 0
      ) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        revealTargets.forEach((el) => observer.observe(el));
      } else {
        // Fallback: if no observer, just show everything.
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
