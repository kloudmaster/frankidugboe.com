---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-slate-200 bg-white">
  <div class="hero-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
    <div class="reveal max-w-4xl">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">
        <span class="h-px w-8 bg-sky-400" aria-hidden="true"></span>
        {eyebrow}
      </p>

      <h1 class="mt-5 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
        {title}
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        {description}
      </p>
    </div>
  </div>
</section>
