---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">
      {eyebrow}
    </p>

    <h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
      {title}
    </h1>

    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      {description}
    </p>
  </div>
</section>
