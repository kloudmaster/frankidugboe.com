---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a
      href="/"
      class="text-base font-bold tracking-tight text-slate-950"
      aria-label="Frank Osasere Idugboe home"
    >
      Frank Idugboe
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-slate-600 transition hover:text-sky-700"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold">
        Menu
      </summary>

      <nav
        class="absolute right-0 mt-3 w-56 rounded-xl border border-slate-200 bg-white p-3 shadow-xl"
        aria-label="Mobile navigation"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
