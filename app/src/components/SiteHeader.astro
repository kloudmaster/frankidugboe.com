---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;

const currentPath = Astro.url.pathname;

// A nav item is active on its exact path, or when the current path is a
// child of it (e.g. /projects/karpenter-... highlights the Projects item).
function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a
      href="/"
      class="text-base font-bold tracking-tight text-slate-950"
      aria-label="Frank Osasere Idugboe home"
    >
      Frank Idugboe
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition',
              isActive(item.href)
                ? 'text-sky-700'
                : 'text-slate-600 hover:text-sky-700',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="mt-0.5 block h-0.5 rounded-full bg-sky-500" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold">
        Menu
      </summary>

      <nav
        class="absolute right-0 mt-3 w-56 rounded-xl border border-slate-200 bg-white p-3 shadow-xl"
        aria-label="Mobile navigation"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm font-medium',
                isActive(item.href)
                  ? 'bg-sky-50 text-sky-700'
                  : 'text-slate-700 hover:bg-slate-100',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
