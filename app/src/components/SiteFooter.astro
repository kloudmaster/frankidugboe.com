---
interface Props {
  githubUrl?: string;
  linkedinUrl?: string;
}

const {
  githubUrl = 'https://github.com/kloudmaster',
  linkedinUrl = 'https://www.linkedin.com/in/kloudmaster/',
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-300">
  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <p class="text-lg font-bold tracking-tight text-white">
          Frank Osasere Idugboe
        </p>
        <p class="mt-3 text-sm leading-6 text-slate-400">
          Cloud &amp; DevOps Engineer, AWS Community Builder, and Digital
          Forensics Researcher. Building secure, scalable, observable
          infrastructure.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold text-white">Explore</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/projects">Projects</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/experience">Experience</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/research">Research</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/articles">Articles</a></li>
          </ul>
        </div>

        <div>
          <p class="text-sm font-semibold text-white">More</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/certifications">Certifications</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/community">Community</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/about">About</a></li>
            <li><a class="text-slate-400 transition hover:text-sky-400" href="/contact">Contact</a></li>
          </ul>
        </div>

        <div>
          <p class="text-sm font-semibold text-white">Connect</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a
                class="text-slate-400 transition hover:text-sky-400"
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            </li>
            {
              linkedinUrl && (
                <li>
                  <a
                    class="text-slate-400 transition hover:text-sky-400"
                    href={linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    LinkedIn
                  </a>
                </li>
              )
            }
            <li>
              <a class="text-slate-400 transition hover:text-sky-400" href="/contact">
                Contact form
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-slate-800 pt-8 text-sm text-slate-500">
      <p>&copy; {year} Frank Osasere Idugboe. Built with Astro, Terraform, and AWS.</p>
    </div>
  </div>
</footer>
