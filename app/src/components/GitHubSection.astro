---
interface Props {
  githubUrl?: string;
  username?: string;
}

const {
  githubUrl = 'https://github.com/kloudmaster',
  username = 'kloudmaster',
} = Astro.props;

// Self-hosted contribution graph served from our own origin (CloudFront).
// A scheduled GitHub Action (refresh-github-graph.yml) refreshes the committed
// SVG, so there is no third-party call at runtime. A CSS grid is shown as a
// fallback if the image is unavailable.
const chartSrc = '/images/github-contributions.svg';

const cells = Array.from({ length: 84 }, (_, i) => (i * 7 + (i % 5) * 3) % 5);
const levelClass = [
  'bg-slate-800',
  'bg-emerald-900',
  'bg-emerald-700',
  'bg-emerald-500',
  'bg-emerald-400',
];
---

<section class="bg-slate-950 pb-24 text-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class="reveal card-lift overflow-hidden rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-900/40 p-8 sm:p-10"
    >
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-400">
            Open source &amp; code
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            Building in the open on GitHub
          </h2>

          <p class="mt-5 leading-8 text-slate-400">
            Infrastructure as code, automation, Kubernetes tooling, and the
            source behind this site. Explore the repositories and contribution
            history.
          </p>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 font-semibold text-slate-950 transition hover:bg-slate-200"
          >
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            View @{username} on GitHub
          </a>
        </div>

        <div class="w-full max-w-md shrink-0">
          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <!-- Live contribution graph; falls back to the CSS grid on error. -->
            <img
              src={chartSrc}
              alt={`GitHub contribution graph for ${username}`}
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
              data-gh-chart
            />

            <div
              id="gh-fallback"
              class="hidden w-max grid-flow-col grid-rows-7 gap-1"
              aria-hidden="true"
            >
              {
                cells.map((level) => (
                  <span class={`h-3 w-3 rounded-sm ${levelClass[level]}`} />
                ))
              }
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-slate-500">
            Contribution activity
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // If the live contribution image fails to load, reveal the CSS fallback grid.
  const chart = document.querySelector('[data-gh-chart]');
  const fallback = document.getElementById('gh-fallback');

  if (chart && fallback) {
    chart.addEventListener('error', () => {
      (chart as HTMLElement).style.display = 'none';
      fallback.style.display = 'grid';
    });
  }
</script>
