---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'Certifications | Frank Osasere Idugboe';
---

<BaseLayout
  title={title}
  description="Current certifications, professional training, certification renewal work, and previously held credentials of Frank Osasere Idugboe."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="Certifications"
      title="Professional credentials with transparent status."
      description="Current certifications, professional training, certifications in progress, and previously held credentials are separated clearly so their status is unambiguous."
    />

    <section class="bg-white py-16">
      <div class="mx-auto grid max-w-7xl gap-6 px-6 md:grid-cols-2 lg:px-8">
        <article class="rounded-2xl border border-slate-200 p-7">
          <h2 class="text-xl font-bold text-slate-950">Active Certifications</h2>
          <p class="mt-3 leading-7 text-slate-600">
            Current verified professional certifications will be listed here.
          </p>
        </article>

        <article class="rounded-2xl border border-slate-200 p-7">
          <h2 class="text-xl font-bold text-slate-950">In Progress</h2>
          <p class="mt-3 leading-7 text-slate-600">
            AWS recertification and continuing professional development.
          </p>
        </article>

        <article class="rounded-2xl border border-slate-200 p-7">
          <h2 class="text-xl font-bold text-slate-950">Professional Training</h2>
          <p class="mt-3 leading-7 text-slate-600">
            Includes Mercor — Introduction to Agents, completed in 2026.
          </p>
        </article>

        <article class="rounded-2xl border border-slate-200 p-7">
          <h2 class="text-xl font-bold text-slate-950">Previously Held</h2>
          <p class="mt-3 leading-7 text-slate-600">
            Expired certifications, including previous AWS credentials and
            KCNA, are retained here with their historical status clearly marked.
          </p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
