---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'Research | Frank Osasere Idugboe';
---

<BaseLayout
  title={title}
  description="Digital forensics, cloud forensics, IoT forensics, and forensic-ready systems research by Frank Osasere Idugboe."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="Research"
      title="Digital evidence at the intersection of cloud and connected systems."
      description="Graduate research focused on forensic readiness, trustworthy logging, cloud-connected IoT systems, digital evidence, and chain-of-custody considerations."
    />

    <section class="bg-white py-16">
      <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-slate-950">Current research direction</h2>

        <p class="mt-5 leading-8 text-slate-600">
          My current work explores forensic-ready IoT logging for livestock
          traceability, connecting edge devices, long-range communication,
          gateway infrastructure, cloud services, and evidence-preservation
          requirements.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
