---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'Research | Frank Osasere Idugboe';

const researchAreas = [
  'cloud forensics',
  'IoT forensics',
  'digital evidence',
  'forensic readiness',
  'chain of custody',
];

const researchStack = [
  'ESP32',
  'RFID',
  'LoRa',
  'Raspberry Pi',
  'MQTT',
  'Local Database',
  'AWS IoT Core',
  'ThingsBoard',
];
---

<BaseLayout
  title={title}
  description="Forensic Science research at UNIFESSPA focused on cloud forensics, IoT forensics, forensic-ready logging, digital evidence, and connected systems."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="Research"
      title="Digital evidence at the intersection of cloud and connected systems."
      description="Graduate research in Forensic Science at UNIFESSPA focused on forensic-ready systems, cloud-connected IoT, trustworthy logging, and evidence preservation."
    />

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr]">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
              Current research
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
              Forensic-ready IoT logging for livestock traceability
            </h2>

            <p class="mt-6 leading-8 text-slate-600">
              My current research explores a forensic-ready IoT architecture for livestock traceability, with emphasis on preserving reliable event logs that can support later digital investigation.
            </p>

            <p class="mt-5 leading-8 text-slate-600">
              The research connects edge devices, identification technologies,
              long-range communication, gateway infrastructure, local data
              storage, cloud services, and forensic evidence requirements.
            </p>

            <p class="mt-5 leading-8 text-slate-600">
              The central forensic concern is not simply collecting operational
              data. The system should produce logs that are useful for
              reconstruction, integrity checking, attribution, digital evidence
              handling, and chain of custody.
            </p>
          </div>

          <aside class="rounded-2xl bg-slate-950 p-7 text-white">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-400">
              Research areas
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {
                researchAreas.map((area) => (
                  <span class="rounded-full border border-slate-700 px-3 py-1.5 text-sm text-slate-300">
                    {area}
                  </span>
                ))
              }
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
          Proposed technology path
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
          From edge identification to cloud evidence workflows
        </h2>

        <div class="mt-8 rounded-2xl bg-slate-950 p-7 font-mono text-sm leading-8 text-slate-300">
          <p>ESP32 + RFID / Sensors</p>
          <p class="pl-4">↓</p>
          <p>LoRa</p>
          <p class="pl-4">↓</p>
          <p>Raspberry Pi Gateway</p>
          <p class="pl-4">↓</p>
          <p>MQTT + Local Database</p>
          <p class="pl-4">↓</p>
          <p>AWS IoT Core / ThingsBoard</p>
          <p class="pl-4">↓</p>
          <p>Forensic-ready logging and evidence analysis</p>
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          {
            researchStack.map((technology) => (
              <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700">
                {technology}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-950">
          Research perspective
        </h2>

        <p class="mt-6 max-w-4xl leading-8 text-slate-600">
          My broader interests include cloud forensics, IoT forensics,
          forensic-ready infrastructure, digital evidence workflows,
          trustworthy logging, and the relationship between operational
          observability and forensic investigation.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
