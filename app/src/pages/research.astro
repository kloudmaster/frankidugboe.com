---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'Research | Frank Osasere Idugboe';

const researchAreas = [
  'digital chain of custody',
  'data provenance',
  'IoT forensics',
  'forensic readiness',
  'edge computing',
  'livestock traceability',
  'digital evidence',
  'cloud forensics',
];

const researchStack = [
  'ESP32',
  'MicroPython',
  'USB/UART',
  'Raspberry Pi',
  'Python / PySerial',
  'SQLite',
  'REST / HTTPS',
  'FastAPI',
  'PostgreSQL',
  'HMAC-SHA-256',
  'Design Science Research',
];

const publications = [
  {
    title: 'Machine Learning-Driven Intrusion Detection with Forensic Readiness in Cloud-Native IoT Environments',
    journal: 'American Journal of Electrical and Computer Engineering',
    details: 'Vol. 10, pp. 1–18, 2026',
    doi: 'https://doi.org/10.11648/j.ajece.20261001.11',
    authors: 'Idugboe, F.; Okonkwo, H.; Ejiyere, B.; Ugo, E.',
    published: 'Jun 2026',
  },
  {
    title: 'Cloud Forensic Tools and Storage: A Systematic Mapping Study',
    journal: 'GAS Journal of Engineering and Technology',
    details: 'Vol. 3, pp. 54–64, 2026',
    doi: 'https://doi.org/10.5281/ZENODO.19313810',
    authors: 'Idugboe, F. O.; Junior, W.; Castro, V.',
    published: 'Mar 2026',
  },
];
---

<BaseLayout
  title={title}
  description="Forensic Sciences research at UNIFESSPA: IoT prototype for livestock traceability, digital chain-of-custody documentation, data provenance, and HMAC-based record integrity."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="Research"
      title="Documenting the digital path of records in IoT systems."
      description="Master's research in Forensic Sciences at UNIFESSPA focused on building an IoT prototype that records livestock traceability events and supports digital chain-of-custody documentation across edge, gateway, and server."
    />

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr]">
          <div class="reveal">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
              Current research
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
              IoT prototype for livestock traceability and digital chain-of-custody documentation
            </h2>

            <p class="mt-6 leading-8 text-slate-600">
              My dissertation develops a functional IoT prototype that records simulated livestock identification and movement events, preserving and correlating their representations across an edge device, gateway, and server under controlled conditions.
            </p>

            <p class="mt-5 leading-8 text-slate-600">
              The core research question is: how can an IoT system record livestock traceability events and support documentation of the digital path of the records? The work distinguishes the logical event, its concrete representations, and the operations performed on them — tracking what the system actually received and processed without attributing evidentiary force the architecture cannot support.
            </p>

            <p class="mt-5 leading-8 text-slate-600">
              At the gateway, received bytes are preserved before any transformation, local persistence is maintained with a durable outbox, and HMAC-SHA-256 is applied in two independent domains — one protecting the edge message, another protecting the gateway synchronisation envelope. The server provides idempotent reception, confirmation after persistence, and query/export functions. I adopt Design Science Research as the methodological orientation and treat the prototype as an instantiation.
            </p>
          </div>

          <aside class="reveal reveal-delay-1 card-lift rounded-2xl bg-slate-950 p-7 text-white hover:shadow-lg hover:shadow-sky-500/10">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-400">
              Research areas
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {
                researchAreas.map((area) => (
                  <span class="rounded-full border border-slate-700 px-3 py-1.5 text-sm text-slate-300">
                    {area}
                  </span>
                ))
              }
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            System architecture
          </p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
            From edge event to server-side digital path documentation
          </h2>

          <div class="mt-8 rounded-2xl bg-slate-950 p-7 font-mono text-sm leading-8 text-slate-300">
            <p>ESP32 (MicroPython)</p>
            <p class="pl-2 text-slate-500 text-xs">Generate event, deterministic JSON, HMAC-D</p>
            <p class="pl-4">↓ USB / UART</p>
            <p>Raspberry Pi Gateway (Python / PySerial)</p>
            <p class="pl-2 text-slate-500 text-xs">Preserve received bytes, SQLite local persistence, durable outbox, HMAC-G</p>
            <p class="pl-4">↓ REST / HTTPS</p>
            <p>Project-controlled Server (FastAPI)</p>
            <p class="pl-2 text-slate-500 text-xs">Contract validation, HMAC verification, idempotent reception, PostgreSQL persistence</p>
            <p class="pl-4">↓</p>
            <p>Digital path documentation and query/export</p>
          </div>

          <div class="mt-8 flex flex-wrap gap-2">
            {
              researchStack.map((technology) => (
                <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700">
                  {technology}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="reveal">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            Publications
          </p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
            Peer-reviewed publications
          </h2>

          <div class="mt-8 space-y-6">
            {
              publications.map((pub) => (
                <article class="card-lift rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:border-sky-200 hover:shadow-md">
                  <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                    <div>
                      <p class="text-sm font-semibold text-sky-700">{pub.journal}</p>
                      <h3 class="mt-2 text-lg font-bold text-slate-950">{pub.title}</h3>
                      <p class="mt-2 text-sm text-slate-500">{pub.authors}</p>
                      <p class="mt-1 text-sm text-slate-500">{pub.details}</p>
                    </div>
                    <p class="inline-flex shrink-0 items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                      {pub.published}
                    </p>
                  </div>
                  <div class="mt-5">
                    <a
                      href={pub.doi}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-semibold text-sky-700 hover:text-sky-600"
                    >
                      View publication →
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-slate-950">
            Research perspective
          </h2>

          <p class="mt-6 max-w-4xl leading-8 text-slate-600">
            My broader interests include digital forensics, forensic-ready IoT systems, data provenance, cloud forensics, trustworthy logging, and the relationship between operational observability and the documentation of digital evidence. This work is situated at UNIFESSPA in Marabá, Pará, Brazil, with defence scheduled for February 2027.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
