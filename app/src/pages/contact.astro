---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'Contact | Frank Osasere Idugboe';
---

<BaseLayout
  title={title}
  description="Contact Frank Osasere Idugboe regarding Cloud, DevOps, infrastructure, Cloud Security, technical writing, research, and professional collaboration."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="Contact"
      title="Start a professional conversation."
      description="For Cloud, DevOps, infrastructure, Cloud Security, technical writing, research, and professional collaboration."
    />

    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 lg:grid-cols-[0.7fr_1.3fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
            Contact
          </p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
            Professional enquiries
          </h2>

          <p class="mt-6 leading-8 text-slate-600">
            Use this form for engineering opportunities, technical
            collaboration, research discussions, speaking, mentoring, or other
            professional enquiries.
          </p>

          <div class="mt-8 rounded-2xl bg-slate-950 p-6 text-sm leading-7 text-slate-300">
            <p class="font-semibold text-white">
              Serverless contact architecture
            </p>

            <p class="mt-3">
              The production form will submit through API Gateway to AWS Lambda,
              with Amazon SES handling delivery to a private professional
              inbox.
            </p>

            <p class="mt-3">
              No private email address is exposed publicly.
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <form id="contact-form">
            <div class="grid gap-6">
              <div>
                <label
                  for="name"
                  class="block text-sm font-semibold text-slate-900"
                >
                  Full name
                </label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  maxlength="100"
                  class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-sm font-semibold text-slate-900"
                >
                  Email address
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
                />
              </div>

              <div>
                <label
                  for="subject"
                  class="block text-sm font-semibold text-slate-900"
                >
                  Subject
                </label>

                <input
                  id="subject"
                  name="subject"
                  type="text"
                  required
                  minlength="3"
                  maxlength="150"
                  class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
                />
              </div>

              <div>
                <label
                  for="message"
                  class="block text-sm font-semibold text-slate-900"
                >
                  Message
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="7"
                  required
                  minlength="20"
                  maxlength="5000"
                  class="mt-2 w-full resize-y rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-sky-600 focus:ring-2 focus:ring-sky-100"
                ></textarea>
              </div>

              <div
                class="absolute left-[-10000px] top-auto h-px w-px overflow-hidden"
                aria-hidden="true"
              >
                <label for="company_website">
                  Leave this field empty
                </label>

                <input
                  id="company_website"
                  name="company_website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <div>
                <button
                  type="submit"
                  class="inline-flex rounded-lg bg-slate-950 px-5 py-3 font-semibold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"
                >
                  Send message
                </button>

                <p
                  id="contact-status"
                  class="mt-4 text-sm leading-6 text-slate-600"
                  role="status"
                  aria-live="polite"
                >
                  The form interface is ready. Messages are delivered securely
                  through the AWS backend.
                </p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#contact-status');
    const submitButton = form?.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );

    const ENDPOINT = '/api/contact';

    function setStatus(message: string) {
      if (status) {
        status.textContent = message;
      }
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());

      submitButton?.setAttribute('disabled', 'true');
      setStatus('Sending your message…');

      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.reset();
          setStatus('Thank you — your message has been sent successfully.');
        } else if (response.status === 422) {
          setStatus(
            'Some fields need attention. Please review your entries and try again.',
          );
        } else if (response.status === 429) {
          setStatus(
            'Too many attempts. Please wait a moment before trying again.',
          );
        } else {
          setStatus(
            'Something went wrong while sending your message. Please try again later.',
          );
        }
      } catch {
        setStatus(
          'Network error. Please check your connection and try again.',
        );
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>
