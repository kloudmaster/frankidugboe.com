---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import { navItems } from '../data/navigation';

const title = 'About | Frank Osasere Idugboe';

const capabilities = [
  'AWS',
  'Kubernetes',
  'Terraform',
  'CloudFormation',
  'Docker',
  'GitHub Actions',
  'Jenkins',
  'Ansible',
  'CI/CD',
  'Cloud Security',
  'Observability',
  'Incident Troubleshooting',
];
---

<BaseLayout
  title={title}
  description="About Frank Osasere Idugboe, Cloud & DevOps Engineer, AWS Community Builder, and Digital Forensics Researcher."
>
  <SiteHeader navItems={navItems} />

  <main>
    <PageHero
      eyebrow="About"
      title="Cloud engineering, production operations, and Digital Forensics."
      description="I am a Cloud & DevOps Engineer with 8+ years of experience across infrastructure, automation, cloud security, production operations, and technical leadership."
    />

    <section class="bg-white py-16 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.4fr_0.8fr] lg:px-8">
        <div class="reveal">
          <h2 class="text-2xl font-bold tracking-tight text-slate-950">
            Engineering background
          </h2>

          <p class="mt-5 leading-8 text-slate-600">
            My work spans AWS cloud infrastructure, Kubernetes and EKS,
            Infrastructure as Code with Terraform and CloudFormation,
            configuration automation, CI/CD, observability, IAM, networking,
            cloud security, and production incident troubleshooting.
          </p>

          <p class="mt-5 leading-8 text-slate-600">
            I have worked across engineering and DevOps roles supporting cloud
            platforms, application delivery, infrastructure automation, and
            operational reliability. My approach emphasizes repeatable
            infrastructure, secure access, observable systems, documented
            engineering decisions, and practical incident analysis.
          </p>

          <div class="mt-12 h-px w-16 bg-sky-200" aria-hidden="true"></div>

          <h2 class="mt-12 text-2xl font-bold tracking-tight text-slate-950">
            Digital Forensics research
          </h2>

          <p class="mt-5 leading-8 text-slate-600">
            Alongside my engineering career, I am pursuing a Master's degree in
            Forensic Science at UNIFESSPA in Brazil, with research interests in
            Digital Forensics, cloud forensics, forensic-ready IoT systems,
            digital evidence, trustworthy logging, and chain of custody.
          </p>

          <p class="mt-5 leading-8 text-slate-600">
            This combination of production cloud engineering and forensic
            research shapes how I think about infrastructure: systems should
            not only be scalable and secure, but also observable, auditable,
            and capable of preserving useful evidence when incidents occur.
          </p>
        </div>

        <aside class="reveal reveal-delay-1">
          <div class="card-lift rounded-2xl border border-slate-200 bg-slate-50 p-7 hover:border-sky-200 hover:shadow-md">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">
              Core capabilities
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {
                capabilities.map((capability) => (
                  <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-sky-300 hover:text-sky-700">
                    {capability}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="card-lift mt-6 rounded-2xl bg-slate-950 p-7 text-white hover:shadow-lg hover:shadow-sky-500/10">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-400">
              Current focus
            </p>

            <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-300">
              {
                [
                  'Cloud & DevOps Engineering',
                  'Cloud Security',
                  'AWS & Kubernetes',
                  'Infrastructure as Code',
                  'Digital Forensics Research',
                  'Technical Writing & Community',
                ].map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-400" aria-hidden="true" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
