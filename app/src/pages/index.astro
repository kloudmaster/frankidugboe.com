---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Frank Osasere Idugboe — Cloud & DevOps Engineer, AWS Community Builder, and Digital Forensics Researcher."
    />
    <title>Frank Osasere Idugboe | Cloud & DevOps Engineer</title>
  </head>

  <body>
    <main class="min-h-screen bg-slate-950 text-white">
      <section
        class="mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24 lg:px-8"
      >
        <div class="max-w-4xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-sky-400">
            Cloud · DevOps · Infrastructure as Code
          </p>

          <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
            Frank Osasere Idugboe
          </h1>

          <p class="mt-6 text-xl font-medium text-slate-300 sm:text-2xl">
            Cloud &amp; DevOps Engineer · AWS Community Builder · Digital Forensics Researcher
          </p>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-400">
            I design secure, scalable, and observable cloud infrastructure
            using AWS, Kubernetes, Terraform, and modern DevOps practices,
            with a growing research focus on cloud and digital forensics.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/projects"
              class="rounded-lg bg-sky-500 px-6 py-3 font-semibold text-slate-950 transition hover:bg-sky-400"
            >
              View Projects
            </a>

            <a
              href="/cv/frank-osasere-idugboe-resume.pdf"
              class="rounded-lg border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-slate-500 hover:bg-slate-900"
            >
              Download CV
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
