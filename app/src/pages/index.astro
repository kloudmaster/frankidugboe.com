---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import GitHubSection from '../components/GitHubSection.astro';
import { navItems } from '../data/navigation';

const featuredProjects = [
  {
    title: 'Kubernetes / Karpenter Incident Debugging',
    category: 'Incident Engineering',
    description:
      'A production troubleshooting case study tracing pending Kubernetes workloads through resource requests, Karpenter identity and IAM trust, and EBS Availability Zone affinity.',
    href: '/projects/karpenter-incident-debugging',
    tags: ['Kubernetes', 'Karpenter', 'AWS IAM', 'EBS'],
  },
  {
    title: 'EBS Encryption Automation',
    category: 'Cloud Security Automation',
    description:
      'Automating EBS encryption compliance and remediation using AWS Config, Systems Manager automation, and infrastructure-as-code practices.',
    href: '/projects/ebs-encryption-automation',
    tags: ['AWS Config', 'SSM', 'EBS', 'CloudFormation'],
  },
  {
    title: 'KEDA Event-Driven Autoscaling',
    category: 'Cloud Native',
    description:
      'A Kubernetes autoscaling proof of concept using KEDA to connect event-driven workload demand with dynamic pod scaling and operational testing.',
    href: '/projects/keda-autoscaling',
    tags: ['KEDA', 'Kubernetes', 'Autoscaling', 'Observability'],
  },
  {
    title: 'Production AWS Portfolio Platform',
    category: 'Platform Engineering',
    description:
      'This site as a project: a static Astro app on private S3 and CloudFront with a serverless contact backend, WAF, DNSSEC, observability, and a credential-free Terraform + GitHub Actions (OIDC) delivery pipeline.',
    href: '/projects/portfolio-platform',
    tags: ['AWS', 'Terraform', 'GitHub Actions', 'OIDC'],
  },
];
---

<BaseLayout>
  <SiteHeader navItems={navItems} />

  <main>
    <section class="relative overflow-hidden bg-white">
      <div class="hero-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative mx-auto grid min-h-[78vh] max-w-7xl items-center gap-14 px-6 py-24 lg:grid-cols-[1fr_auto] lg:px-8">
        <div class="reveal max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">
            Cloud · DevOps · Infrastructure as Code
          </p>

          <h1 class="mt-5 text-5xl font-bold tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
            Frank Osasere Idugboe
          </h1>

          <p class="mt-6 text-xl font-medium text-slate-700 sm:text-2xl">
            Cloud &amp; DevOps Engineer · AWS Community Builder · Digital
            Forensics Researcher
          </p>

          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
            I design secure, scalable, and observable cloud infrastructure
            using AWS, Kubernetes, Terraform, and modern DevOps practices,
            with a growing research focus on cloud and digital forensics.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#featured-projects"
              class="rounded-lg bg-slate-950 px-6 py-3 font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"
            >
              View Projects
            </a>

            <a
              href="/cv/frank-osasere-idugboe-resume.pdf"
              download
              class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"
            >
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M10 12.5a1 1 0 01-.7-.29l-3.5-3.5 1.4-1.42L9 9.09V2h2v7.09l1.8-1.8 1.4 1.42-3.5 3.5a1 1 0 01-.7.29z"></path>
                <path d="M4 15h12v2H4z"></path>
              </svg>
              Download CV
            </a>
          </div>

          <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium text-slate-500">
            <span>AWS</span>
            <span>Kubernetes</span>
            <span>Terraform</span>
            <span>GitHub Actions</span>
            <span>Cloud Security</span>
            <span>Observability</span>
          </div>
        </div>

        <div class="reveal reveal-delay-1 hidden justify-self-center md:block">
          <div class="relative">
            <div
              class="absolute -inset-3 rounded-[2rem] bg-gradient-to-tr from-sky-400 via-sky-200 to-emerald-300 opacity-70 blur-lg"
              aria-hidden="true"
            ></div>
            <img
              src="/images/frank-idugboe.png"
              alt="Frank Osasere Idugboe"
              width="288"
              height="288"
              loading="eager"
              decoding="async"
              class="relative h-64 w-64 rounded-[1.75rem] border border-white/60 object-cover shadow-xl lg:h-72 lg:w-72"
            />
          </div>
        </div>
      </div>
    </section>

    <FeaturedProjects projects={featuredProjects} />

    <GitHubSection />

    <section class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid gap-8 md:grid-cols-3">
          <div class="reveal card-lift rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:border-sky-200 hover:shadow-md">
            <p class="text-sm font-semibold text-sky-700">Engineering</p>
            <h2 class="mt-2 text-xl font-bold">Cloud infrastructure</h2>
            <p class="mt-3 leading-7 text-slate-600">
              AWS architecture, Kubernetes platforms, Infrastructure as Code,
              CI/CD, observability, and production troubleshooting.
            </p>
          </div>

          <div class="reveal reveal-delay-1 card-lift rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:border-sky-200 hover:shadow-md">
            <p class="text-sm font-semibold text-sky-700">Research</p>
            <h2 class="mt-2 text-xl font-bold">Digital forensics</h2>
            <p class="mt-3 leading-7 text-slate-600">
              Research interests spanning cloud forensics, forensic-ready IoT
              systems, digital evidence, and security engineering.
            </p>
          </div>

          <div class="reveal reveal-delay-2 card-lift rounded-2xl border border-slate-200 bg-white p-7 shadow-sm hover:border-sky-200 hover:shadow-md">
            <p class="text-sm font-semibold text-sky-700">Community</p>
            <h2 class="mt-2 text-xl font-bold">Technical knowledge sharing</h2>
            <p class="mt-3 leading-7 text-slate-600">
              AWS Community Builder, technical writer, mentor, and practitioner
              focused on documenting real engineering problems and solutions.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
